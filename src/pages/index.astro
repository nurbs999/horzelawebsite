---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ExampleSwitcher from '../components/ExampleSwitcher.astro';
import { siteConfig, contactMailto, services, steps, faqs } from '../data/site';
---
<BaseLayout>
  <section class="hero section" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="eyebrow"><span class="status-dot"></span> KI FÜR KLEINE UNTERNEHMEN & HANDWERK</p>
        <h1 id="hero-title">KI, die im <br />Betrieb<br /><span>mitarbeitet.</span></h1>
        <p class="hero-description">Ich bin Martin Horzela. Ich bringe KI in Ihre Arbeitsabläufe, entwickle passende Software und mache Ihr Team fit für den Einsatz im Alltag.</p>
        <div class="hero-actions">
          <a class="button button-dark" href="#kontakt">Projekt besprechen <Icon name="diagonal" size={19} /></a>
          <a class="text-link" href="#leistungen">Möglichkeiten entdecken <Icon name="down" size={17}/></a>
        </div>
        <div class="hero-personal"><span class="mini-monogram" aria-hidden="true">mh</span><p>Ein Ansprechpartner.<br /><strong>Von der Idee bis zur Anwendung.</strong></p></div>
      </div>
      <div class="hero-visual">
        <figure class="hero-photo">
          <img src="/images/werkstatt-ki.webp" srcset="/images/werkstatt-ki-640.webp 640w, /images/werkstatt-ki-960.webp 960w, /images/werkstatt-ki.webp 1440w" sizes="(max-width: 760px) calc(100vw - 40px), (max-width: 1100px) 48vw, 570px" width="1440" height="960" fetchpriority="high" loading="eager" alt="Laptop und kompakter KI-Rechner auf einer Werkbank im warmen Fensterlicht – KI-generiertes Symbolbild." />
          <figcaption class="hero-image-caption">Handwerk trifft digitale Möglichkeiten.<span>KI-generiertes Symbolbild</span></figcaption>
        </figure>
        <div class="hero-sticker" aria-hidden="true"><Icon name="spark" size={28}/><span>Technik, die<br />weiterhilft.</span></div>
        <div class="hero-demo"><ExampleSwitcher /></div>
        <span class="visual-coordinate" aria-hidden="true">MENSCH + TECHNIK + ALLTAG</span>
      </div>
    </div>
  </section>

  <div class="container trust-strip" aria-label="Schwerpunkte der Zusammenarbeit">
    <p><Icon name="code" size={23}/><span>Webentwicklung <strong>seit 2013</strong></span></p>
    <p><Icon name="cube" size={23}/><span>Erfahrung mit <strong>WebGL & 3D</strong></span></p>
    <p><Icon name="people" size={23}/><span>Persönlich begleitet. <strong>Praktisch umgesetzt.</strong></span></p>
  </div>

  <section class="section services-section" id="leistungen" aria-labelledby="services-title">
    <div class="container">
      <div class="section-intro">
        <div><p class="eyebrow"><span class="section-number">01</span> WAS ICH FÜR SIE TUN KANN</p><h2 id="services-title">Aus Möglichkeiten<br />wird <span class="text-green">Alltag.</span></h2></div>
        <p>KI ist dann hilfreich, wenn sie eine konkrete Aufgabe löst. Wir schauen auf Ihren Betrieb – und setzen dort an, wo Unterstützung wirklich gebraucht wird.</p>
      </div>
      <div class="services-grid">
        {services.map(service => <article class={`service-card service-${service.key}`}>
          <div class="service-meta"><span>{service.number} / {service.category}</span><Icon name={service.icon} size={29}/></div>
          {service.key === 'local' && <div class="knowledge-visual" aria-hidden="true"><span><Icon name="document" size={16}/>Anleitungen</span><span><Icon name="document" size={16}/>Produktwissen</span><span class="knowledge-center"><Icon name="spark" size={19}/></span><span class="knowledge-answer"><Icon name="check" size={14}/> Wissen finden</span></div>}
          <h3>{service.title.split('\n').map((line, i) => <>{i > 0 && <br/>}{line}</>)}</h3>
          <p>{service.description}</p>
          <div class="service-bottom"><strong>{service.benefit}</strong><div class="service-tags">{service.tags.map(tag => <span>{tag}</span>)}</div></div>
        </article>)}
      </div>
      <p class="section-footnote"><Icon name="check" size={18} /> Keine fertige KI-Strategie nötig. Eine konkrete Aufgabe aus Ihrem Betrieb genügt für den Anfang.</p>
    </div>
  </section>

  <section class="case-section section" id="praxis" aria-labelledby="case-title">
    <div class="container">
      <div class="case-heading"><p class="eyebrow"><span class="section-number">02</span> EINBLICK IN DIE PRAXIS</p><span class="project-status"><span></span>Laufende Zusammenarbeit</span></div>
      <div class="case-intro"><h2 id="case-title">Gute Ideen brauchen<br /><span>jemanden, der sie umsetzt.</span></h2><p>Bei Pina-Design, einem Anbieter von Sonnensegeln und Montagesystemen, wird KI Schritt für Schritt Teil der Arbeit.</p></div>
      <div class="case-grid">
        <figure class="case-image">
          <img src="/images/sonnensegel-praxis.webp" srcset="/images/sonnensegel-praxis-640.webp 640w, /images/sonnensegel-praxis-960.webp 960w, /images/sonnensegel-praxis.webp 1440w" sizes="(max-width: 760px) calc(100vw - 40px), 55vw" width="1440" height="960" loading="lazy" decoding="async" alt="Helles Sonnensegel über einer mediterranen Terrasse – KI-generierte Illustration, keine Aufnahme des Kundenprojekts." />
          <div class="case-image-label"><span>Pina-Design</span><span>SONNENSEGEL · MONTAGESYSTEME</span></div>
          <figcaption>KI-generierte Illustration · keine Projektaufnahme</figcaption>
        </figure>
        <div class="case-details">
          <p class="case-kicker">DREI BAUSTEINE. EIN GEMEINSAMER WEG.</p>
          <div class="case-item"><span>01</span><div><h3>Lokale KI aufbauen.</h3><p>Eine KI-Umgebung entsteht, die auf die Anforderungen und das Unternehmenswissen von Pina-Design abgestimmt wird.</p></div></div>
          <div class="case-item"><span>02</span><div><h3>Den Konfigurator weiterdenken.</h3><p>Ein KI-Chatbot wird in den 3D-Konfigurator eingebunden, um Nutzer bei ihren Fragen und bei der Orientierung zu unterstützen.</p></div></div>
          <div class="case-item"><span>03</span><div><h3>Mit KI entwickeln lernen.</h3><p>Ich unterstütze Pina-Design dabei, KI für die Programmierung des Konfigurators einzusetzen und die Ergebnisse fachlich einzuordnen.</p></div></div>
          <a class="text-link text-link-light" href="#kontakt">Was wäre in Ihrem Betrieb möglich? <Icon name="diagonal" size={19}/></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section about-section" id="ueber-mich" aria-labelledby="about-title">
    <div class="container about-grid">
      <div class="about-visual">
        <div class="identity-card">
          <div class="identity-top"><span>ENTWICKLER. MITDENKER.</span><Icon name="code" size={22}/></div>
          <span class="identity-monogram" aria-hidden="true">mh<span>·</span></span>
          <div class="identity-bottom"><span>Martin Horzela</span><p>Technik verstehen.<br />Menschen mitnehmen.</p></div>
          <div class="identity-grid" aria-hidden="true"></div>
        </div>
        <div class="experience-row"><div><strong>2013</strong><span>Webentwicklung</span></div><div><strong>2016</strong><span>WebGL & 3D</span></div><p>Erfahrung,<br />die mitdenkt.</p></div>
      </div>
      <div class="about-copy">
        <p class="eyebrow"><span class="section-number">03</span> IHR ANSPRECHPARTNER</p>
        <h2 id="about-title">Ich plane mit.<br /><span class="text-green">Und entwickle mit.</span></h2>
        <p class="large-copy">Hallo, ich bin Martin. Ich verbinde Erfahrung in der Softwareentwicklung mit der Frage, was Ihrem Betrieb im Alltag weiterhilft.</p>
        <p>Seit 2013 arbeite ich in der Webentwicklung – mit Frontend, Backend und Qualitätssicherung. Seit 2016 gehört auch WebGL dazu. Projektmanagement und die Einschätzung von Entwicklungsaufwänden ergänzen meine technische Arbeit.</p>
        <p>Diese Erfahrung bringe ich in Ihr KI-Projekt ein: Wir verstehen die Aufgabe, entwickeln eine passende Lösung und machen Ihr Team mit der Anwendung vertraut.</p>
        <div class="about-promise"><span class="promise-line"></span><strong>Sie sprechen mit dem Menschen,<br />der die Umsetzung begleitet.</strong></div>
        <div class="profile-links"><a href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="diagonal" size={15}/><span class="sr-only"> (öffnet in neuem Tab)</span></a><a href={siteConfig.xing} target="_blank" rel="noopener noreferrer">XING <Icon name="diagonal" size={15}/><span class="sr-only"> (öffnet in neuem Tab)</span></a></div>
      </div>
    </div>
  </section>

  <section class="section process-section" id="ablauf" aria-labelledby="process-title">
    <div class="container">
      <div class="section-intro"><div><p class="eyebrow"><span class="section-number">04</span> SO ARBEITEN WIR ZUSAMMEN</p><h2 id="process-title">Ein guter Anfang.<br /><span class="text-green">Ein klarer Weg.</span></h2></div><p>Wir beginnen mit einer greifbaren Aufgabe. Daraus entsteht Schritt für Schritt eine Lösung, die zu Ihren Abläufen und Ihrem Team passt.</p></div>
      <ol class="process-grid">{steps.map(step => <li><span class="step-number">{step.number}</span><h3>{step.title}</h3><p>{step.text}</p></li>)}</ol>
    </div>
  </section>

  <section class="section faq-section" id="fragen" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <div class="faq-intro"><p class="eyebrow">GUT ZU WISSEN</p><h2 id="faq-title">Noch eine <br />Frage?</h2><p>Der Einstieg soll verständlich sein.<br />Hier sind die wichtigsten Antworten.</p><a href="#kontakt" class="text-link">Ihre Frage besprechen <Icon name="diagonal" size={18}/></a></div>
      <div class="faq-list">{faqs.map((faq, index) => <details name="faq"><summary><span class="faq-index">0{index + 1}</span><h3>{faq.question}</h3><Icon name="plus" size={22}/></summary><div class="faq-answer"><p>{faq.answer}</p></div></details>)}</div>
    </div>
  </section>

  <section class="contact-section" id="kontakt" aria-labelledby="contact-title">
    <div class="container contact-inner">
      <div class="contact-copy"><p class="eyebrow"><span class="status-dot"></span> DER ERSTE SCHRITT IST EIN GESPRÄCH</p><h2 id="contact-title">Welche Aufgabe<br />kostet Sie immer<br /><span>wieder Zeit?</span></h2><p>Erzählen Sie mir von Ihrem Betrieb und der Aufgabe, bei der Sie Unterstützung suchen. Eine fertige Idee für die Lösung brauchen Sie noch nicht.</p></div>
      <div class="contact-panel">
        <span class="contact-icon" aria-hidden="true"><Icon name="diagonal" size={56}/></span>
        <h3>Lassen Sie uns<br />konkret werden.</h3>
        <p>Ein paar Sätze genügen für den Anfang:</p>
        <ul class="contact-prompts"><li><Icon name="check" size={17}/> Was macht Ihr Betrieb?</li><li><Icon name="check" size={17}/> Wo wünschen Sie sich Unterstützung?</li><li><Icon name="check" size={17}/> Welche Software nutzen Sie bereits?</li></ul>
        <div class="contact-address">
          {siteConfig.contactReady ? <a href={contactMailto}>{siteConfig.email}</a> : <span>{siteConfig.email}</span>}
        </div>
        {siteConfig.contactReady ? <a class="button button-lime" href={contactMailto}>Projekt per E-Mail anfragen <Icon name="diagonal" size={19}/></a> : <><button class="button button-lime" id="copy-email" data-email={siteConfig.email}><span>Adresse kopieren</span><Icon name="copy" size={18}/></button><p class="contact-pending">Die E-Mail-Adresse wird noch eingerichtet.<br />Bitte senden Sie noch keine Anfrage.</p></>}
        <p class="copy-status" role="status" aria-live="polite" id="copy-status"></p>
      </div>
    </div>
    <div class="contact-decoration" aria-hidden="true">↗</div>
  </section>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-email');
  copyButton?.addEventListener('click', async () => {
    const status = document.querySelector<HTMLElement>('#copy-status');
    const email = copyButton.dataset.email || '';
    try {
      await navigator.clipboard.writeText(email);
      if (status) status.textContent = 'Adresse kopiert. Das Postfach wird noch eingerichtet.';
      const label = copyButton.querySelector('span');
      if (label) label.textContent = 'Adresse kopiert';
    } catch {
      if (status) status.textContent = `Bitte kopieren Sie die Adresse manuell: ${email}`;
    }
  });
</script>
