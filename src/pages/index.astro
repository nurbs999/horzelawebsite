---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { siteConfig, contactMailto, projects, processPhases, faqs } from '../data/site';
---
<BaseLayout>
  <!-- HERO SECTION -->
  <section class="hero section" id="start" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div class="hero-content">
        <p class="eyebrow"><span class="status-dot"></span> 3D · WEBGL · KI · PROJEKTE VON A BIS Z</p>
        <h1 id="hero-title">Softwareprojekte <br />von A bis Z.<br /><span>Mitgedacht. Entwickelt.</span></h1>
        <p class="hero-description">Ich bin Martin Horzela. Ich baue keine isolierten Code-Schnipsel, sondern begleite anspruchsvolle 3D-, Web- und KI-Projekte als technischer Partner: von der ehrlichen Schätzung und dem tiefen Produktverständnis über die 100%ige Umsetzung bis zum Release und jahrelanger Pflege.</p>
        <div class="hero-actions">
          <a class="button button-dark" href="#projekte">Leuchtturm-Projekte ansehen <Icon name="down" size={19} /></a>
          <a class="text-link" href="#prozess">Der A–Z Prozess <Icon name="diagonal" size={17}/></a>
        </div>
        <div class="hero-personal">
          <span class="mini-monogram" aria-hidden="true">mh</span>
          <p>Kein Code-Monkey.<br /><strong>Ihr technischer Partner von A bis Z.</strong></p>
        </div>
      </div>
      <div class="hero-visual">
        <figure class="hero-photo">
          <img src="/images/pina-konfigurator.jpg" width="1440" height="960" fetchpriority="high" loading="eager" alt="Pina Sonnensegel 3D-Konfigurator mit RAG-Chatbot – entwickelt von Martin Horzela" />
          <figcaption class="hero-image-caption">Projekt-Highlight: Pina 3D-Konfigurator<span>Echtzeit-WebGL & integrierte KI-Beratung</span></figcaption>
        </figure>
        <div class="hero-sticker" aria-hidden="true">
          <Icon name="spark" size={26}/>
          <span>A bis Z<br />Begleitung</span>
        </div>
        <div class="hero-metrics-pill">
          <div><strong>WebGL</strong><span>seit 2016</span></div>
          <div class="pill-divider"></div>
          <div><strong>100%</strong><span>Inhouse Code</span></div>
          <div class="pill-divider"></div>
          <div><strong>RAG / KI</strong><span>integriert</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- VALUE STRIP -->
  <div class="container trust-strip" aria-label="Kernkompetenzen">
    <p><Icon name="code" size={22}/><span><strong>01. Ehrliche Schätzung</strong> & Machbarkeit</span></p>
    <p><Icon name="cube" size={22}/><span><strong>02. Tiefes Verständnis</strong> für Ihr Produkt</span></p>
    <p><Icon name="spark" size={22}/><span><strong>03. 100% Umsetzung</strong> (3D, Web, KI)</span></p>
    <p><Icon name="people" size={22}/><span><strong>04. Verlässliche Pflege</strong> über Jahre</span></p>
  </div>

  <!-- SHOWCASE PROJECTS SECTION -->
  <section class="section projects-section" id="projekte" aria-labelledby="projects-title">
    <div class="container">
      <div class="section-intro">
        <div>
          <p class="eyebrow"><span class="section-number">01</span> LEUCHTTURM-PROJEKTE</p>
          <h2 id="projects-title">Aus Ideen werden<br /><span class="text-green">funktionierende Systeme.</span></h2>
        </div>
        <p>Keine theoretischen Konzepte, sondern echte Anwendungen. Hier sehen Sie, wie anspruchsvolle Produktanforderungen in performante Software übersetzt werden.</p>
      </div>

      <div class="projects-showcase">
        {projects.map((project) => (
          <article class={`project-card project-card-${project.id}`}>
            <div class="project-header">
              <div class="project-meta">
                <span class="project-number">{project.number}</span>
                <span class={`project-badge badge-${project.badgeType}`}>{project.badge}</span>
              </div>
              <div class="project-tags">
                {project.tags.map(tag => <span>{tag}</span>)}
              </div>
            </div>

            <div class="project-body-grid">
              <div class="project-info">
                <h3>{project.title}</h3>
                <p class="project-subtitle">{project.subtitle}</p>
                <p class="project-overview">{project.overview}</p>

                <div class="project-process-steps">
                  <p class="process-steps-label">DER PROZESS VON A BIS Z:</p>
                  <ol>
                    {project.steps.map(s => (
                      <li>
                        <span class="step-num">{s.step}</span>
                        <div>
                          <strong>{s.title}</strong>
                          <p>{s.desc}</p>
                        </div>
                      </li>
                    ))}
                  </ol>
                </div>

                <div class="project-actions">
                  {project.liveUrl && project.liveUrl.startsWith('http') ? (
                    <a class="button button-dark" href={project.liveUrl} target="_blank" rel="noopener noreferrer">
                      Live-Anwendung testen <Icon name="diagonal" size={17} />
                    </a>
                  ) : (
                    <a class="button button-dark" href="#kontakt">
                      Projektidee anfragen <Icon name="diagonal" size={17} />
                    </a>
                  )}
                  {project.client && <span class="project-client">Kunde / Kontext: {project.client}</span>}
                </div>
              </div>

              <div class="project-media">
                {project.image ? (
                  <figure class="media-frame">
                    <img src={project.image} alt={project.title} loading="lazy" />
                    <div class="media-overlay">
                      <span>{project.title}</span>
                    </div>
                  </figure>
                ) : (
                  <div class="media-placeholder">
                    <div class="placeholder-content">
                      <Icon name="spark" size={48} />
                      <h4>Ihr Leuchtturm-Projekt</h4>
                      <p>Haben Sie eine anspruchsvolle Idee im Kopf? Sprechen wir über die Machbarkeit und die nächsten Schritte.</p>
                      <a class="button button-lime" href="#kontakt">Projekt unverbindlich besprechen <Icon name="diagonal" size={18} /></a>
                    </div>
                  </div>
                )}
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- THE A-Z PROCESS (WARUM KEIN CODE-MONKEY) -->
  <section class="section process-section" id="prozess" aria-labelledby="process-title">
    <div class="container">
      <div class="section-intro">
        <div>
          <p class="eyebrow"><span class="section-number">02</span> DER A–Z PROZESS</p>
          <h2 id="process-title">Warum kein<br /><span class="text-green">„Code-Monkey“?</span></h2>
        </div>
        <p>Reines Tippen von Code reicht nicht. Ein erfolgreiches Projekt braucht jemanden, der von der ersten Schätzung bis zur jahrelangen Betreuung die Gesamtverantwortung im Blick behält.</p>
      </div>

      <div class="process-phases-grid">
        {processPhases.map((phase) => (
          <div class="phase-card">
            <span class="phase-number">{phase.number}</span>
            <span class="phase-tagline">{phase.tagline}</span>
            <h3>{phase.title}</h3>
            <p>{phase.text}</p>
          </div>
        ))}
      </div>
      <div class="process-footer-banner">
        <div>
          <h4>Ein Ansprechpartner für Ihr gesamtes Projekt.</h4>
          <p>Keine Weitergabe an ungelernte Subunternehmer. Sie arbeiten direkt mit dem Entwickler, der Ihr Projekt realisiert.</p>
        </div>
        <a class="button button-dark" href="#kontakt">Zusammenarbeit starten <Icon name="diagonal" size={17} /></a>
      </div>
    </div>
  </section>

  <!-- ABOUT SECTION -->
  <section class="section about-section" id="ueber-mich" aria-labelledby="about-title">
    <div class="container about-grid">
      <div class="about-visual">
        <div class="identity-card">
          <div class="identity-top"><span>SOFTWARE-ENGINEER · MITDENKER</span><Icon name="code" size={22}/></div>
          <span class="identity-monogram" aria-hidden="true">mh<span>·</span></span>
          <div class="identity-bottom"><span>Martin Horzela</span><p>Technik verstehen.<br />Menschen mitnehmen.</p></div>
          <div class="identity-grid" aria-hidden="true"></div>
        </div>
        <div class="experience-row">
          <div><strong>2013</strong><span>Webentwicklung</span></div>
          <div><strong>2016</strong><span>WebGL & 3D</span></div>
          <p>Erfahrung,<br />die mitdenkt.</p>
        </div>
      </div>
      <div class="about-copy">
        <p class="eyebrow"><span class="section-number">03</span> IHR TECHNISCHER PARTNER</p>
        <h2 id="about-title">Ich plane mit.<br /><span class="text-green">Und entwickle selbst.</span></h2>
        <p class="large-copy">Hallo, ich bin Martin. Ich verbinde über ein Jahrzehnt Erfahrung in professioneller Softwareentwicklung mit dem Anspruch, Projekte ganzheitlich zum Erfolg zu führen.</p>
        <p>Seit 2013 bin ich in der Webentwicklung zu Hause – mit Frontend, Backend und Qualitätssicherung. Seit 2016 liegt mein Schwerpunkt auf interaktivem 3D im Browser (WebGL). Projektmanagement, fundierte Aufwandsschätzungen und moderne KI-Integrationen (RAG) runden mein Profil ab.</p>
        <p>Ich verstehe Ihre Branche, entwickle die Software eigenhändig und stehe Ihnen auch Jahre nach dem Release als verlässlicher Partner zur Seite.</p>
        <div class="about-promise">
          <span class="promise-line"></span>
          <strong>Sie sprechen mit dem Menschen,<br />der die Umsetzung persönlich verantwortet.</strong>
        </div>
        <div class="profile-links">
          <a href={siteConfig.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <Icon name="diagonal" size={15}/><span class="sr-only"> (öffnet in neuem Tab)</span></a>
          <a href={siteConfig.xing} target="_blank" rel="noopener noreferrer">XING <Icon name="diagonal" size={15}/><span class="sr-only"> (öffnet in neuem Tab)</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ SECTION -->
  <section class="section faq-section" id="fragen" aria-labelledby="faq-title">
    <div class="container faq-grid">
      <div class="faq-intro">
        <p class="eyebrow"><span class="section-number">04</span> GUT ZU WISSEN</p>
        <h2 id="faq-title">Häufige<br />Fragen</h2>
        <p>Transparenz ist die Basis einer guten Partnerschaft.<br />Hier sind die wichtigsten Antworten.</p>
        <a href="#kontakt" class="text-link">Ihre Frage direkt besprechen <Icon name="diagonal" size={18}/></a>
      </div>
      <div class="faq-list">
        {faqs.map((faq, index) => (
          <details name="faq">
            <summary>
              <span class="faq-index">0{index + 1}</span>
              <h3>{faq.question}</h3>
              <Icon name="plus" size={22}/>
            </summary>
            <div class="faq-answer"><p>{faq.answer}</p></div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- CONTACT SECTION -->
  <section class="contact-section" id="kontakt" aria-labelledby="contact-title">
    <div class="container contact-inner">
      <div class="contact-copy">
        <p class="eyebrow"><span class="status-dot"></span> DER ERSTE SCHRITT IST EIN GESPRÄCH</p>
        <h2 id="contact-title">Haben Sie ein Projekt,<br />das <span>mitgedacht werden will?</span></h2>
        <p>Egal ob 3D-Konfigurator, VR-Visualisierung oder ein individuelles KI-System: Erzählen Sie mir von Ihrem Vorhaben. Eine fertige technische Spezifikation brauchen Sie noch nicht.</p>
      </div>
      <div class="contact-panel">
        <span class="contact-icon" aria-hidden="true"><Icon name="diagonal" size={56}/></span>
        <h3>Lassen Sie uns<br />konkret werden.</h3>
        <p>Ein paar Sätze genügen für den Anfang:</p>
        <ul class="contact-prompts">
          <li><Icon name="check" size={17}/> Was soll Ihre Anwendung können?</li>
          <li><Icon name="check" size={17}/> Gibt es bereits bestehende Systeme oder 3D-Daten?</li>
          <li><Icon name="check" size={17}/> In welchem Zeitrahmen planen Sie?</li>
        </ul>
        <div class="contact-address">
          <a href={contactMailto}>{siteConfig.email}</a>
        </div>
        <div class="contact-btn-row">
          <a class="button button-lime" href={contactMailto}>
            Projekt per E-Mail anfragen <Icon name="diagonal" size={19}/>
          </a>
          <button class="button button-dark" id="copy-email" data-email={siteConfig.email} type="button">
            <span>Adresse kopieren</span> <Icon name="copy" size={18}/>
          </button>
        </div>
        <p class="copy-status" role="status" aria-live="polite" id="copy-status"></p>
      </div>
    </div>
    <div class="contact-decoration" aria-hidden="true">↗</div>
  </section>
</BaseLayout>

<script>
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-email');
  copyButton?.addEventListener('click', async () => {
    const status = document.querySelector<HTMLElement>('#copy-status');
    const email = copyButton.dataset.email || '';
    try {
      await navigator.clipboard.writeText(email);
      if (status) status.textContent = 'E-Mail-Adresse in die Zwischenablage kopiert!';
      const label = copyButton.querySelector('span');
      if (label) label.textContent = 'Kopiert!';
      setTimeout(() => {
        if (label) label.textContent = 'Adresse kopieren';
        if (status) status.textContent = '';
      }, 3000);
    } catch {
      if (status) status.textContent = `Bitte kopieren Sie die Adresse manuell: ${email}`;
    }
  });
</script>
